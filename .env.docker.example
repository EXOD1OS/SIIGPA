# Referencia para el archivo privado .env.docker. La preparación genera claves propias.
APP_PORT=3000
DB_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DEMO_SEED_IF_EMPTY=true
S3_REGION=us-east-1
S3_BUCKET=planificaciones-pdf
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_ENV_FILE=./config/minio/root.env
MINIO_LICENSE_FILE=./config/minio/minio.license
# Para un volumen AIStor existente, indicar la misma imagen antes de arrancarlo:
# MINIO_IMAGE=quay.io/minio/aistor/minio:VERSION_INSTALADA
