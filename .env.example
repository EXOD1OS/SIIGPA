DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siga_planificaciones?schema=public"
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# S3-compatible private object storage (MinIO locally, another S3 endpoint later).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="planificaciones-pdf"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Comma-separated archive types; unset means all supported types.
EXPEDIENTE_PDF_TIPOS="PAAC,PAAD,INFORME_PEDAGOGICO,INFORME_DISCIPLINAR,INFORME_GENERAL"
